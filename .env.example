# =============================================================================
# ICSF — copia a .env y rellena TODO lo marcado PEGAR_*
# Dashboard: https://supabase.com/dashboard/project/kjwkawcjrlfjjulaidhu
# =============================================================================

# ---- App / Auth.js (local o producción) ----
AUTH_SECRET="cambia-esto-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
# En producción: AUTH_URL="https://TU-DOMINIO"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ---- Supabase (proyecto kjwkawcjrlfjjulaidhu) ----
# Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://kjwkawcjrlfjjulaidhu.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="PEGAR_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="PEGAR_SERVICE_ROLE_KEY"

# Settings → Database → Connection string
# Directa (5432) — migraciones y seed. Sustituye PEGAR_PASSWORD_DB.
DIRECT_URL="postgresql://postgres:PEGAR_PASSWORD_DB@db.kjwkawcjrlfjjulaidhu.supabase.co:5432/postgres?sslmode=require"

# Pooler (6543) — la app en runtime. Pégala completa desde el dashboard
# (Session/Transaction pooler). Si aún no la tienes, deja la misma que DIRECT_URL.
DATABASE_URL="postgresql://postgres.kjwkawcjrlfjjulaidhu:PEGAR_PASSWORD_DB@PEGAR_HOST_POOLER:6543/postgres?pgbouncer=true&sslmode=require"

# CLI (Account → Access Tokens) — para que el agente publique / migre sin login interactivo
SUPABASE_ACCESS_TOKEN="PEGAR_ACCESS_TOKEN"
SUPABASE_PROJECT_REF="kjwkawcjrlfjjulaidhu"
SUPABASE_DB_PASSWORD="PEGAR_PASSWORD_DB"

# ---- OpenAI ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY="PEGAR_OPENAI_API_KEY"
OPENAI_MODEL="gpt-4o-mini"

# ---- Publicar la app (Railway) ----
# railway.com → Account Settings → Tokens
# En el servicio, define las mismas variables de arriba: AUTH_*, DATABASE_URL, DIRECT_URL, OPENAI_*.
RAILWAY_TOKEN="PEGAR_RAILWAY_TOKEN"

# ---- Firebase FCM (después; no bloquea el alta a Postgres) ----
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""

# ---- Seed (primera carga en Supabase) ----
SEED_ADMIN_EMAIL="admin@icsf.local"
SEED_ADMIN_PASSWORD="cambia-esto"
SEED_MEMBER_PASSWORD="icsf-demo"
